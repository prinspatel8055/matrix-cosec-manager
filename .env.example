# Matrix COSEC Device Configuration Template
# Copy this file to .env and configure with your device details

# Target device network settings
MATRIX_DEVICE_IP=192.168.1.20
MATRIX_DEVICE_PORT=80

# Authentication credentials
MATRIX_USER_LEVEL=0
MATRIX_ADMIN_PIN=1234

# General
REQUEST_TIMEOUT_SECONDS=5
EXPORT_DIRECTORY=./exports
